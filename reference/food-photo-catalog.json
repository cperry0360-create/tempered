{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "purpose": "Illustrative stock-photo candidates for Tempered's visual prototype. Not a nutrition database and not a photo-redistribution product.",
  "prototypeOnly": true,
  "shippingPlan": "After approval, bundle selected optimized thumbnails with the app's offline asset precache. Keep provenance, license URL, alt text, user overrides, and neutral fallback. Do not download/host an entire stock-photo marketplace catalog.",
